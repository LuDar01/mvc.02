<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <header class="site-header" style="background-image: url({{ asset('img/LDsun.jpeg') }})">
        <nav class= 'navbar'>
            <ul>
                <li class='nav-title'><a href="{{ path('me') }}">Me</a></li>
                <li class='nav-title'><a href="{{ path('about') }}">About</a></li>
                <li class='nav-title'><a href="{{ path('report') }}">Report</a></li>
                <li class= 'nav-title'><a href="{{ path('lucky_number') }}">Lucky</a></li>
                <li class= 'nav-title'><a href="{{ path('json_api') }}">Api</a></li>
                <li class= 'nav-title'><a href="{{ path('pig_start') }}">Card</a></li>


            </ul>
        </nav>
        </header>

    <main>{% block body %} {% endblock %}</main>

    <footer class="site-footer" style="background-image: url({{ asset('img/IMG_3826.JPG') }})"></footer>
    </body>
</html>