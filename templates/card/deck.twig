{% extends "base.html.twig" %}

{% block title %}Card Deck{% endblock %}

{% block body %}
<h2>Hela kortleken</h2>

<div class="actions">
    <a href="{{ path('card_home') }}">Back to home</a>
</div>

<p>{{ count }} kort totalt</p>
<div class="card-container">
    {% for card in cards %}
        <div class="card {{ card.getSuitClass() }}">
            <div class="card-top">{{ card.getValueAsString() }}{{ card.getSuitSymbol() }}</div>
            <div class="card-center">{{ card.getSuitSymbol() }}</div>
            <div class="card-bottom">{{ card.getValueAsString() }}{{ card.getSuitSymbol() }}</div>
        </div>
    {% endfor %}
    
</div>

{% endblock %}